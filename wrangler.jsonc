{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "converteasy",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "converteasy.lowkey.tools",
      "custom_domain": true
    }
  ]
}
