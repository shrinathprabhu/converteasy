{
  "name": "converteasy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Convert units, currency, crypto and dates, and calculate with units. A free, offline-ready PWA from lowkey.tools.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "assets": "node scripts/make-assets.mjs",
    "preview:workers": "npm run build && wrangler dev",
    "deploy:workers": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "esbuild": "^0.28.2",
    "wrangler": "^4.131.1"
  }
}
